@database :memory:

# A FROM-clause subquery that an outer join, a CROSS JOIN or an earlier
# subquery keeps in an inner loop is stored in a table once instead of running
# as a coroutine for each outer row. These tests check the rows of that plan,
# including NULL-extended rows of the LEFT JOIN.

setup schema {
    CREATE TABLE watchlist (type_id INTEGER PRIMARY KEY, name TEXT);
    CREATE TABLE history_txt (type_id VARCHAR, price REAL);
    INSERT INTO watchlist VALUES (1, '10'), (2, '300'), (3, 'x'), (4, NULL), (5, '200');
    INSERT INTO history_txt VALUES ('1', 5), ('1', 7), ('2', 100), ('3', 500), ('3', NULL), (NULL, 4), ('9', 1);
}

@setup schema
test left-join-subquery-text-key {
    SELECT w.type_id, h.type_id, h.avgp FROM watchlist w LEFT JOIN (SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id) h ON w.type_id = h.type_id ORDER BY w.type_id;
}
expect {
    1|1|6.0
    2|2|100.0
    3|3|500.0
    4||
    5||
}

@setup schema
test left-join-subquery-non-equality {
    SELECT w.type_id, h.type_id, h.avgp FROM watchlist w LEFT JOIN (SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id) h ON w.name > h.avgp ORDER BY w.type_id, h.type_id;
}
expect {
    1|9|1.0
    2|2|100.0
    2|9|1.0
    3||4.0
    3|1|6.0
    3|2|100.0
    3|3|500.0
    3|9|1.0
    4||
    5|2|100.0
    5|9|1.0
}

@setup schema
test cross-join-subquery {
    SELECT w.type_id, h.type_id FROM watchlist w CROSS JOIN (SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id) h WHERE w.name > h.avgp ORDER BY w.type_id, h.type_id;
}
expect {
    1|9
    2|2
    2|9
    3|
    3|1
    3|2
    3|3
    3|9
    5|2
    5|9
}

@setup schema
test subquery-after-left-join {
    SELECT w.type_id, t.price, h.type_id FROM watchlist w LEFT JOIN history_txt t ON t.price = w.type_id JOIN (SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id) h ON w.name > h.avgp ORDER BY w.type_id, h.type_id;
}
expect {
    1|1.0|9
    2||2
    2||9
    3||
    3||1
    3||2
    3||3
    3||9
    5|5.0|2
    5|5.0|9
}

@setup schema
test subquery-after-subquery {
    SELECT a.type_id, b.type_id FROM (SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id) a, (SELECT type_id, max(price) AS maxp FROM history_txt GROUP BY type_id) b WHERE a.avgp + b.maxp > 100 ORDER BY a.type_id, b.type_id;
}
expect {
    |2
    |3
    1|2
    1|3
    2|
    2|1
    2|2
    2|3
    2|9
    3|
    3|1
    3|2
    3|3
    3|9
    9|2
    9|3
}

@setup schema
test left-join-cte {
    WITH h AS (SELECT type_id, avg(price) AS avgp FROM history_txt GROUP BY type_id) SELECT w.type_id, h.type_id FROM watchlist w LEFT JOIN h ON w.name > h.avgp ORDER BY w.type_id, h.type_id;
}
expect {
    1|9
    2|2
    2|9
    3|
    3|1
    3|2
    3|3
    3|9
    4|
    5|2
    5|9
}
